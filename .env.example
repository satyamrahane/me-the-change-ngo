# ==============================================================================
# "Me The Change" (NGO) - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY.
# Copy this file to `.env.local` for local development.

# --- Public Application Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment Gateway (Razorpay) ---
# When testing locally without credentials, set NEXT_PUBLIC_MOCK_PAYMENTS=true
NEXT_PUBLIC_MOCK_PAYMENTS=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# --- Database & Persistence (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# --- Contact & External Integrations ---
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
