# ==============================================================================
# "Me The Change" (NGO) - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY.
# Copy this file to `.env.local` for local development.

# --- Public Application Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment Gateway (Razorpay) ---
# Set PAYMENTS_MODE=mock for local test simulation without live credentials.
# Set PAYMENTS_MODE=live for production Razorpay processing.
PAYMENTS_MODE=mock
NEXT_PUBLIC_MOCK_PAYMENTS=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit_real_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_placeholder_api_key
NOTIFICATION_EMAIL=your_official_ngo_recipient_email_placeholder
EMAIL_FROM=Me The Change Notifications <your_verified_sender_email_placeholder>

# --- Database & Persistence (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# --- Contact & External Integrations ---
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
